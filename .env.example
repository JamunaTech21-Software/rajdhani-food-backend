# Copy to .env and fill in. Every variable the application reads is listed here;
# a blank value means "optional, falls back to a documented default". Anything
# read through Env::require() will stop the process at boot if it is missing.
#
# Nothing in this file is a real credential. See doc section 15.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
LOG_LEVEL=debug

# The admin dashboard's own base URL — a separate front-end (doc §19
# deviation 7). Used only to build the action links in the admin-invite and
# password-reset emails (RTPP-33, §14.4). No fixed domain is assumed (§19
# item 1); change this per environment.
ADMIN_URL=http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3307
# Local development uses the isolated MySQL 8 in bin/mysql8.sh over a socket;
# production uses host/port. When set, the socket wins.
DB_SOCKET=
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Comma-separated. An origin not on this list is refused by the CORS middleware.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
COOKIE_DOMAIN=

# Two independent secrets, both at least 32 characters. The admin and customer
# token families are separated by the JWT `aud` claim, not by the key, so
# rotating these invalidates every session on both sites at once.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=2592000
ADMIN_ACCESS_EXPIRY=900
ADMIN_REFRESH_EXPIRY=604800

# The Super Admin bin/seed.php creates. The account is seeded WITHOUT a
# password and holds an invite token; it cannot be logged into until that
# invite is accepted (doc 7.2). Use a different address per environment so
# staging and production do not share an account.
SEED_ADMIN_EMAIL=admin@rajdhanifood.com
SEED_ADMIN_NAME=Super Admin

# Google Identity Services (doc §7.1). The client ID is NOT a secret — it ships
# in the customer bundle. Its authorised JavaScript origins must list the
# customer site only; admins do not sign in with Google (doc §7.2).
GOOGLE_CLIENT_ID=

# Issued alongside the client ID but unused: the browser mints the ID token and
# the API verifies it against Google's public JWKS. Only a server-side
# authorisation-code flow would need this, and section 7.1 does not use one.
GOOGLE_CLIENT_SECRET=

# Pending from the client (RTPP-17).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RTPP-17 #7: the client will send through Gmail rather than a transactional
# service. MAIL_USERNAME/MAIL_PASSWORD must be a Google App Password, not the
# account password — Gmail has refused plain SMTP AUTH since 2022, and this
# fails silently as an auth error at send time, not at config time.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=jamunatech21@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=jamunatech21@gmail.com
MAIL_FROM_NAME=Rajdhani Food Products

# Pending from the client (doc §19: "reCAPTCHA keys are provided by the
# client"), like the Cloudinary and Gmail credentials above. RTPP-34's
# RecaptchaVerifier treats a blank secret as "skip, logged" rather than an
# error — the same resilience choice Mailer already makes for SMTP.
RECAPTCHA_SECRET_KEY=

# Shared secret for the cPanel cron entries (doc 16.5), so a scheduled job
# endpoint cannot be triggered from the open internet.
CRON_TOKEN=

# Docs page access in production. Absent means the docs are closed.
DOCS_TOKEN=
