{
  "name": "jamunatech/rajdhani-api",
  "description": "Rajdhani Tea Platform — backend REST API (PHP 8.3 + MySQL 8)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ezyang/htmlpurifier": "^4.18",
    "phpmailer/phpmailer": "^6.9",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0",
    "symfony/yaml": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "Rajdhani\\": "app/",
      "Rajdhani\\Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Support/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Rajdhani\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse",
    "fix": "php-cs-fixer fix",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "migrate": "php bin/migrate.php up",
    "check": [
      "@lint",
      "@stan",
      "@test",
      "@openapi"
    ],
    "seed": "php bin/seed.php",
    "openapi": "php bin/openapi.php check"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
